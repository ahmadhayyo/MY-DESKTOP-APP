# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Virtual env
venv/
.venv/

# Local data (not source) — ALL SQLite databases + WAL/SHM sidecars are runtime
# state, never source. Glob patterns catch every DB the app creates.
*.db
*.db-shm
*.db-wal
*.db.old.*
*.sqlite
*.sqlite3
integrations.json
last_session.json
agent_facts.json
scheduled_jobs.json
# Telegram (Telethon) session = login credentials, NEVER commit
telegram_user.session
*.session
*.session-journal
.browser_profile/
.files/
logs/

# Secrets
.env

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
test_voice.mp3
*.tmp

# Build artifacts (PyInstaller etc.) — not source
build/
dist/
*.spec
*.exe
